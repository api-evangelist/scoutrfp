{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Strategic Sourcing attachments project_types API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "project_types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Project Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
