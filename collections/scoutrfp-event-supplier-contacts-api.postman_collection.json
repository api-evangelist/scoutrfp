  "item": [
    {
      "id": "b835b739-422f-4f0d-be7e-5b23cc17a4dd",
      "name": "event_supplier_contacts",
      "description": {
        "content": "Use the event supplier contacts API to manage event suppliers. This API provides 2 advantages over the event supplier companies APIs:\n- It allows specifying the supplier contact to be associated/removed from an event.\n- It allows specifying multiple contacts for a given supplier.\n",
        "type": "text/plain"
      },
      "item": [
